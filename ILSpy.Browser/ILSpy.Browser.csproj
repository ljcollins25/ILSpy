<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <!-- Relink the wasm runtime (smaller, trimmed native bits) without `dotnet workload install`:
       build/NoWorkloadWasm.props fetches the WebAssembly toolchain packs from NuGet instead.
       Set before the import: the props decide which packs to fetch from it.
       The opt-in AOT build is -p:NoWorkloadWasmAot=true (see publish-browser.ps1 -Aot). -->
  <PropertyGroup>
    <WasmBuildNative>true</WasmBuildNative>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)build/NoWorkloadWasm.props" />
  <PropertyGroup>
    <!-- net10.0-browser, not net11.0-browser: the .NET 11 preview wasm workload links with
         Emscripten 6.x + wasm exceptions, for which SkiaSharp (Avalonia's renderer) ships no
         static library yet; the .NET 10 workload uses Emscripten 3.1.56, which SkiaSharp
         supports. The accompanying global.json pins the .NET 10 SDK for this directory. -->
    <TargetFramework>net10.0-browser</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <RootNamespace>ICSharpCode.ILSpy.Browser</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- ILSpy.csproj is an executable (the desktop head), but this project consumes its
         output purely as a library; suppress NETSDK1150, which otherwise refuses an
         exe-to-exe reference from a self-contained (wasm) app. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <!-- Precompressed assets are of no value for the local dev loop; publish keeps
         compression on so a static host can serve .br/.gz. -->
    <CompressionEnabled Condition="'$(Configuration)' == 'Debug'">false</CompressionEnabled>
    <!-- No trimming by default; -p:ILSpyBrowserTrim=true (or AOT, which requires trimming)
         turns on full trimming with the app assemblies rooted wholesale below. The custom
         switch exists because a global -p:PublishTrimmed leaks into the referenced
         netstandard2.0 projects, which cannot be trimmed (NETSDK1124).
         Opt-in ahead-of-time compilation for publish: -p:NoWorkloadWasmAot=true (workload-free; a
         global -p:RunAOTCompilation=true would make the SDK ask for the uninstalled workload). -->
    <_ILSpyBrowserTrimEffective Condition="'$(RunAOTCompilation)' == 'true' or '$(NoWorkloadWasmAot)' == 'true' or '$(ILSpyBrowserTrim)' == 'true'">true</_ILSpyBrowserTrimEffective>
    <PublishTrimmed Condition="'$(_ILSpyBrowserTrimEffective)' == 'true'">true</PublishTrimmed>
    <PublishTrimmed Condition="'$(_ILSpyBrowserTrimEffective)' != 'true'">false</PublishTrimmed>
    <!-- Trim-analysis warnings are numerous and third-party; this is an experimental
         publish mode, so keep them out of the way. -->
    <SuppressTrimAnalysisWarnings Condition="'$(_ILSpyBrowserTrimEffective)' == 'true'">true</SuppressTrimAnalysisWarnings>
    <!-- After AOT compilation the IL bodies of AOT'd methods are dead weight in the
         managed assemblies; stripping them shrinks the assembly payload. Methods the AOT
         compiler skipped keep their IL and still run on the interpreter. -->
    <WasmStripILAfterAOT Condition="'$(RunAOTCompilation)' == 'true' or '$(NoWorkloadWasmAot)' == 'true'">true</WasmStripILAfterAOT>
  </PropertyGroup>

  <!-- Trimmer roots. AppComposition builds the MEF container from exactly ILSpy.dll +
       ICSharpCode.ILSpyX.dll (plugins do not exist in the browser), and parts are
       discovered reflectively, invisible to the trimmer; rooting those assemblies whole
       keeps every part, its importing constructor, and everything they statically
       reference. The decompiler assemblies are the product itself: keep them faithful
       rather than risk the trimmer removing rarely-hit paths. Everything else (BCL,
       Avalonia, Dock, editor, transitive packages) trims for real - which also deletes
       assemblies nothing references anymore (TextMateSharp and friends). -->
  <ItemGroup Condition="'$(_ILSpyBrowserTrimEffective)' == 'true'">
    <TrimmerRootAssembly Include="ILSpy" />
    <TrimmerRootAssembly Include="ILSpy.Browser" />
    <TrimmerRootAssembly Include="ICSharpCode.ILSpyX" />
    <TrimmerRootAssembly Include="ICSharpCode.Decompiler" />
    <TrimmerRootAssembly Include="ICSharpCode.BamlDecompiler" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Browser" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ILSpy\ILSpy.csproj" />
  </ItemGroup>

  <!-- Sample assembly served as a static web asset; main.js downloads it into the
       emscripten virtual file system before Main runs and passes its VFS path as a
       command-line argument, so the normal AssembliesToLoad startup path opens it like
       a file on disk. The file is physically copied into wwwroot because the dev server
       serves assets linked from outside wwwroot unreliably (empty bodies), and
       WasmFilesToIncludeInFileSystem trips the SDK over the same linked-asset handling.
       Note: static web assets are discovered at evaluation time, so on a fresh clone the
       sample is picked up from the second build onwards. -->
  <Target Name="StageSampleAssembly" BeforeTargets="AssignTargetPaths">
    <Copy SourceFiles="..\ICSharpCode.Decompiler\bin\$(Configuration)\netstandard2.0\ICSharpCode.Decompiler.dll"
          DestinationFolder="wwwroot\samples"
          SkipUnchangedFiles="true"
          Condition="Exists('..\ICSharpCode.Decompiler\bin\$(Configuration)\netstandard2.0\ICSharpCode.Decompiler.dll')" />
  </Target>
</Project>
